# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules

# Build directory
/.next/
/out/
/build

# PWA files
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/sw.js.map

# SWC cache
/.swc/

# Environment variables
.env
.env*.local
.env.development
.env.production
.env.test

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local configuration
.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

# Miscellaneous
.DS_Store
Thumbs.db
*.pem
*.tsbuildinfo

# Vercel
.vercel

# Config de Firebase App Hosting (obsoleta: la app se despliega en Vercel +
# Supabase). No hace falta en el repo; si vuelves a Firebase, quita esta línea.
apphosting.prod.yaml

# Test coverage
/coverage

# Instrucciones y notas internas de desarrollo con IA (no van al repo público)
CLAUDE.md
AGENTS.md
.claude/
# docs/ solo contiene diagnósticos internos (auditorías, planes de rediseño con
# la IA que listan vulnerabilidades). Se ignora la carpeta completa; si algún
# día hay documentación pública, hacer una excepción con !docs/loquesea.md
/docs/

