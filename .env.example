# Copiar a .env.local y completar con los valores reales.
# En producción, cargar estas mismas variables en el panel del hosting (Vercel).

# --- Supabase ---
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Salta las políticas RLS: nunca exponerla al cliente ni
# prefijarla con NEXT_PUBLIC_. La usan /api/admin/* y /api/auth/register.
SUPABASE_SERVICE_ROLE_KEY=

# --- Asistente GDO (IA) ---
# https://aistudio.google.com/apikey — solo servidor.
GEMINI_API_KEY=

# --- Envío de correo (Orden de Pago) ---
# SMTP genérico: funciona con Zoho, SendGrid, Mailgun o el correo de tu empresa.
# SOLO servidor: nunca prefijar con NEXT_PUBLIC_. Si estas variables no están,
# la app no intenta enviar — avisa que falta configurarlas y deja descargar la
# orden para mandarla a mano.
#
# ZOHO MAIL (la cuenta de este proyecto: hola@gestiondeobras.app)
#   · SMTP_USER es el correo COMPLETO, no solo la parte de antes de la arroba.
#   · SMTP_PASS NO es la clave con la que entras a Zoho: hay que generar una
#     "contraseña de aplicación" en
#     Zoho Mail → Mi cuenta → Seguridad → Contraseñas de aplicación.
#     Con verificación en dos pasos activada, la clave normal la rechaza el SMTP.
#   · El host depende del centro de datos donde se creó la cuenta:
#     smtp.zoho.com (global) · smtp.zoho.eu · smtp.zoho.in · smtp.zoho.com.au
#     Si el envío falla con "authentication failed" y la clave es correcta,
#     casi siempre es el host equivocado.
#   · El remitente tiene que ser una dirección verificada del dominio.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hola@gestiondeobras.app
SMTP_PASS=
SMTP_FROM="Gestión de Obras <hola@gestiondeobras.app>"
# Zoho en el puerto 465 usa SSL directo. Con 587 (STARTTLS) va en false.
SMTP_SECURE=true
