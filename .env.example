# Copiar a .env.local y completar con los valores reales.
# En producción, cargar estas mismas variables en el panel del hosting (Vercel).

# --- Supabase ---
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Salta las políticas RLS: nunca exponerla al cliente ni
# prefijarla con NEXT_PUBLIC_. La usan /api/admin/* y /api/auth/register.
SUPABASE_SERVICE_ROLE_KEY=

# --- Asistente GDO (IA) ---
# https://aistudio.google.com/apikey — solo servidor.
GEMINI_API_KEY=
